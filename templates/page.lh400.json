    "faq": {
      "type": "lh400-faq",
      "settings": {},
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is included in the LAVNA LH400 Locks box?",
            "answer": "<p>The box contains the complete lock set, RFID cards, and manual keys. It also includes screws and a user manual for easy installation.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Is professional installation required?",
            "answer": "<p>The LH400 fits standard wooden doors and comes with every fitting and a user manual, so any carpenter can install it. LAVNA also offers installation and support across 25+ cities.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Does the LH400 lock keep a record of access?",
            "answer": "<p>Yes. Every unlock is recorded, and you can review the past unlocking records of any room in the LAVNA hotel software.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Can managers and housekeeping staff have separate access cards?",
            "answer": "<p>Yes. The LH400 supports separate RFID roles for the hotel manager, guests and housekeeping, each with its own access rights.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What is the LH400 Hotel Door Lock used for?",
            "answer": "<p>It is a smart door lock built for hotels and guest rooms: guests unlock with an RFID card or the mobile app, and staff manage every room from one software.</p>"
          }
        }
      },
