{% schema %}
{
  "name": "LH400 lock dimensions",
  "tag": "div",
  "class": "lh400-dimensions-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "LH400 Lock Dimensions" },
    { "type": "inline_richtext", "id": "note", "label": "Note (desktop)", "default": "LH400 gives <strong>1 year Warranty</strong> and is compatible with <strong>30 - 65mm</strong> Door Thickness." },
    { "type": "header", "content": "Measurements", "info": "Shown on the drawings; values shared by the front and back views." },
    { "type": "text", "id": "panel_height", "label": "Panel height", "default": "26.16 cm" },
    { "type": "text", "id": "panel_width", "label": "Panel width", "default": "7.11 cm" },
    { "type": "text", "id": "handle_projection", "label": "Handle projection", "default": "7.62 cm" },
    { "type": "text", "id": "handle_length", "label": "Handle length", "default": "14.73 cm" },
    { "type": "text", "id": "mortise_height", "label": "Mortise height", "default": "20.32 cm" },
    { "type": "text", "id": "mortise_width", "label": "Mortise width", "default": "9.2 cm" },
    { "type": "text", "id": "mortise_depth", "label": "Mortise face width", "default": "2.5 cm" },
    { "type": "header", "content": "Callouts" },
    { "type": "text", "id": "label_battery", "label": "Battery cover", "default": "BATTERY COVER" },
    { "type": "text", "id": "label_card_reader", "label": "Card reader", "default": "CARD READER" },
    { "type": "text", "id": "label_key_area", "label": "Manual key area", "default": "MANUAL KEY AREA" },
    { "type": "text", "id": "label_privacy", "label": "Privacy trigger", "default": "PRIVACY TRIGGER" },
    { "type": "range", "id": "padding_top", "label": "Top spacing (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 90 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top spacing (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "LH400 lock dimensions" }]
}
{% endschema %}
