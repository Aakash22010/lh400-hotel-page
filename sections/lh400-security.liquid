{%- comment -%}
  LH400 - Security banner
  Figma: 1344x834 banner (mobile 363x225, same ratio).
  Headline, bolts and the warranty badge are part of the image; only the line inside the badge is live text.
{%- endcomment -%}
{% render 'lh400-assets' %}
{{ 'lh400-security.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="lh lh-section lh-security" style="--pt:{{ s.padding_top }};--ptm:{{ s.padding_top_mobile }}">
  <div class="lh-container">
    <div class="lh-security__media">
      {%- # The headline is in the artwork - keep a real heading for SEO / screen readers %}
      {%- if s.heading != blank -%}<h2 class="lh-visually-hidden">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- render 'lh400-image', image: s.image, fallback: 'lh400-security.jpg', alt: s.image_alt, class: 'lh-security__img', sizes: '(min-width: 1440px) 1344px, 94vw', width: 2400, height: 1490 -%}
      {%- # Live text on the warranty badge -%}
      {%- if s.badge_text != blank -%}
        <p class="lh-security__badge">{{ s.badge_text | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LH400 security banner",
  "tag": "div",
  "class": "lh400-security-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image", "info": "The headline, 304 steel bolts and warranty badge are part of the image. 1344 x 834 ratio." },
    { "type": "textarea", "id": "image_alt", "label": "Image description (alt text)", "default": "Heavy Duty. Unbeatable Security. 304 ultra strong steel bolts. 1 year warranty included in LH400." },
    { "type": "text", "id": "heading", "label": "Heading for screen readers and SEO", "default": "Heavy Duty. Unbeatable Security" },
    { "type": "textarea", "id": "badge_text", "label": "Text inside the warranty badge", "default": "included in\nLH400", "info": "Sits inside the round badge of the design image; clear it if your image has no badge." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing (desktop)", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 78 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top spacing (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "LH400 security banner" }]
}
{% endschema %}
